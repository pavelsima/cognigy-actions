{
  "name": "@cxone/chat",
  "version": "1.0.0",
  "description": "CXone Chat - One-liner webchat initialization script with bundled Cognigy webchat",
  "type": "module",
  "main": "dist/cxone-chat.min.js",
  "module": "dist/cxone-chat.esm.js",
  "types": "dist/types/cxone-chat.d.ts",
  "exports": {
    ".": {
      "import": "./dist/cxone-chat.esm.js",
      "require": "./dist/cxone-chat.min.js",
      "types": "./dist/types/cxone-chat.d.ts"
    },
    "./esm": {
      "import": "./dist/cxone-chat.esm.js",
      "types": "./dist/types/cxone-chat.d.ts"
    },
    "./iife": {
      "import": "./dist/cxone-chat.min.js",
      "require": "./dist/cxone-chat.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:wrapper": "npx rollup -c wrapper/rollup.config.js",
    "build:webchat": "cd webchat && npm run build",
    "build:watch": "npx rollup -c wrapper/rollup.config.js -w",
    "serve": "npx serve -p 8080",
    "dev": "node scripts/dev.js",
    "dev:full": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.0",
    "rollup": "^4.6.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "cxone",
    "chat",
    "webchat",
    "cognigy"
  ],
  "author": "CXone Team",
  "license": "MIT"
}
